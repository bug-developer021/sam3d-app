# =============================================================================
# Forma3D Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Authentication (Optional for development, required for production)
# -----------------------------------------------------------------------------
# Auth mode: "disabled", "optional", or "required"
# - disabled: No authentication, all endpoints are public
# - optional: Auth is checked if token provided, but not required
# - required: All endpoints require valid JWT token
AUTH_MODE=optional

# Supabase JWT Secret for token validation
# Get this from: Supabase Dashboard > Project Settings > API > JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# -----------------------------------------------------------------------------
# Hugging Face (Required for downloading SAM 3D checkpoints)
# -----------------------------------------------------------------------------
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here

# -----------------------------------------------------------------------------
# GPU/CUDA Configuration (Docker)
# -----------------------------------------------------------------------------
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# -----------------------------------------------------------------------------
# Storage Paths (Optional - defaults work for most setups)
# -----------------------------------------------------------------------------
# BASE_DIR=/app
# UPLOAD_DIR=/app/storage/uploads
# OUTPUT_DIR=/app/storage/outputs

# -----------------------------------------------------------------------------
# Server Configuration (Optional)
# -----------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000

# -----------------------------------------------------------------------------
# Logging (Optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# VERSION=0.1.0
# FORMA3D_SKIP_MODEL_INIT=false  # set true to skip heavy model init for CI/smoke tests

# -----------------------------------------------------------------------------
# API docs (Optional - useful when running behind a proxy)
# -----------------------------------------------------------------------------
# DOCS_URL=/docs
# REDOC_URL=/redoc
# OPENAPI_URL=/openapi.json

# -----------------------------------------------------------------------------
# Rate limiting (Optional - protects GPU-heavy upload endpoints)
# -----------------------------------------------------------------------------
# RATE_LIMIT_UPLOAD_MAX_REQUESTS=30
# RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
